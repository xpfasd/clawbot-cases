# MySQL 配置模板

## 连接配置

```json
{
  "name": "mysql",
  "description": "MySQL 数据库配置模板",
  "version": "1.0.0",
  "database": "mysql",
  "config": {
    "host": "localhost",
    "port": 3306,
    "database": "mydb",
    "user": "root",
    "password": "${DB_PASSWORD}",
    "charset": "utf8mb4",
    "timezone": "+00:00"
  },
  "connectionString": "mysql://user:password@host:3306/db?charset=utf8mb4",
  "cliTools": ["mysql", "mysqldump"],
  "setup": {
    "install": "brew install mysql",
    "start": "brew services start mysql",
    "connect": "mysql -h localhost -u root -p"
  },
  "envVars": {
    "MYSQL_HOST": "localhost",
    "MYSQL_PORT": "3306",
    "MYSQL_DATABASE": "mydb",
    "MYSQL_USER": "root"
  },
  "features": [
    "ACID 事务",
    "存储过程",
    "触发器",
    "视图",
    "全文索引"
  ]
}
```

## 连接示例

```bash
# 使用 mysql 客户端
mysql -h localhost -u root -p mydb

# 使用环境变量
export MYSQL_PWD="your_password"
mysql -h localhost -u root mydb
```

## 常用命令

```sql
-- 列出所有数据库
SHOW DATABASES;

-- 切换数据库
USE dbname;

-- 列出所有表
SHOW TABLES;

-- 查看表结构
DESCRIBE tablename;

-- 导出数据
mysqldump -u root -p dbname > backup.sql

-- 导入数据
mysql -u root -p dbname < backup.sql
```

## 文件位置
`templates/database/mysql-config.json`
